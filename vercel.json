{
  "version": 2,
  "name": "tw-renpy-generator",
  "env": {
    "GEMINI_API_KEY": "@gemini-api-key",
    "OPENAI_API_KEY": "@openai-api-key"
  },
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x",
      "memory": 128,
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },      // 1) API는 그대로
    { "src": "/(.*)", "dest": "/index.html" }       // 2) 나머지는 SPA로
  ],
  "cleanUrls": true
}
