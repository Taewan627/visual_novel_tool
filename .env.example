# AI API Keys
# Hugging Face API Key (서버리스 함수용)
HF_API_KEY=your_huggingface_api_key_here

# Hugging Face 모델 이름
MODEL_STORY=google/flan-t5-large
MODEL_CHAR=google/flan-t5-large
MODEL_DIALOGUE=google/flan-t5-large

# 기존 API 키 (로컬 개발용)
# Gemini API Key (Google AI Studio에서 발급)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (선택사항)
OPENAI_API_KEY=your_openai_api_key_here

# Vercel 배포 시 사용되는 환경 변수 (Vercel 대시보드에서 설정)
# HF_API_KEY: Hugging Face API 키
# MODEL_STORY: 스토리 생성 모델
# MODEL_CHAR: 캐릭터 생성 모델
# MODEL_DIALOGUE: 대화 생성 모델